CONFIG_BOARD_ESP32CAM=y
# 4 MB quad PSRAM on the AI-Thinker module: frame buffers and big allocations (BMP, JPEG re-encode) go there; <16 KB stays internal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
# camera grab task and its ISR on core 1: core 0 runs the SHA kernel with interrupts off
CONFIG_CAMERA_CORE1=y
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=y
CONFIG_OV5640_SUPPORT=y
