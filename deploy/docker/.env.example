# /data/docker/.env: notifications from certbot and nginx (same as on h1); empty = off
HOST_HOSTNAME=bumblebeam
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The images each service runs, built by CI (.github/workflows/images.yml): a release tag (pool-v1.2.0 -> :1.2.0)
# or a candidate from main (:sha-<7 chars>). A release or a rollback = change one line + up -d <that service>.
POOL_IMAGE=ghcr.io/profinch/bumblebeam-pool:1.0.0
# pool-stratum: the same image, moved on its own and on purpose (a stratum restart drops every miner)
STRATUM_IMAGE=ghcr.io/profinch/bumblebeam-pool:1.0.0
POOL_WEB_IMAGE=ghcr.io/profinch/bumblebeam-pool-web:1.0.0
EXPLORER_WEB_IMAGE=ghcr.io/profinch/bumblebeam-explorer-web:1.0.0
EXPLORER_API_IMAGE=ghcr.io/profinch/bumblebeam-explorer-api:1.0.0
