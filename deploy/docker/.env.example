# /data/docker/.env: notifications from certbot and nginx (same as on h1); empty = off
HOST_HOSTNAME=bumblebeam
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# the pool's commit: picks the source of the bumblebeam-pool image and tags it (pool-stratum and pool-app); required
POOL_REF=
# the pool web UI's commit (pool-web); empty falls back to BUMBLEBEAM_REF, then main
POOL_WEB_REF=
