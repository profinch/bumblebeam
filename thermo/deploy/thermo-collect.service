[Unit]
Description=thermo: temperature, fan, voltage and power collector
After=local-fs.target nvidia-persistenced.service

[Service]
# root: /dev/port (Super I/O), NVMe admin ioctl, RAPL energy counters
ExecStart=/usr/bin/python3 -I /opt/thermo/thermo.py collect
Group=thermo
Restart=always
RestartSec=5
Nice=-5
StateDirectory=thermo
StateDirectoryMode=0770
RuntimeDirectory=thermo
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
